rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.id is string
        && data.id == request.auth.uid
        && data.xpPoints is number
        && data.xpPoints >= 0
        && data.dailyStreak is number
        && data.dailyStreak >= 0;
    }

    // User profiles and game statistics
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
  }
}
